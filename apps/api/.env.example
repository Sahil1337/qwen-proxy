# Copy to .env. Bun loads it from this directory automatically.
# Validated at startup by loadConfig() in @meetai/ingestion — a missing or
# malformed value fails immediately and names itself.

PORT=3000

# The LLM. Any OpenAI-compatible host: apps/proxy is one, so are the hosted
# providers below. Give the host minus the `/v1` — the client appends it.
# PROXY_MODEL goes out verbatim, so it has to be a name that host knows.
# Uncomment one block.

# Groq. Free tier, nothing to install locally.
PROXY_BASE_URL=https://api.groq.com/openai
PROXY_API_KEY=gsk_...
PROXY_MODEL=llama-3.3-70b-versatile

# OpenRouter.
# PROXY_BASE_URL=https://openrouter.ai/api
# PROXY_API_KEY=sk-or-v1-...
# PROXY_MODEL=qwen/qwen-2.5-72b-instruct:free

# OpenAI.
# PROXY_BASE_URL=https://api.openai.com
# PROXY_API_KEY=sk-...
# PROXY_MODEL=gpt-4o-mini

# apps/proxy on your own GPU (`bun run dev:proxy`). Needs Ollama and the model
# pulled. PROXY_API_KEY only if the proxy sets API_KEY.
# PROXY_BASE_URL=http://127.0.0.1:8000
# PROXY_API_KEY=
# PROXY_MODEL=qwen3.5:4b

# The embedding service. Required. Runs on its own machine, not the GPU laptop.
EMBEDDER_BASE_URL=http://127.0.0.1:8100

# Extraction window target in seconds.
# WINDOW_SECONDS=150

# Where the JSON vector index lives, until a database replaces it.
# INDEX_PATH=data/index.json
