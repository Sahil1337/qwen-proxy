# Copy to scripts/.env. Bun loads it from this directory, and only from this
# directory — a .env at the repository root is not read by these scripts.
# Same variable names as apps/api/.env, but its own file, per the one-.env-per-
# workspace rule in CLAUDE.md.

# The host minus the `/v1` the client appends.
PROXY_BASE_URL=https://api.groq.com/openai
PROXY_API_KEY=gsk_...
PROXY_MODEL=llama-3.3-70b-versatile
