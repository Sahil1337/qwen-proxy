# ---- HTTP ---------------------------------------------------------------
PORT=8000
# Optional. When set, /v1/* requires "Authorization: Bearer <API_KEY>".
API_KEY=
LOG_LEVEL=info

# ---- Ollama process -----------------------------------------------------
# The proxy starts and supervises `ollama serve` itself (no systemd unit).
# Set OLLAMA_MANAGED=false to attach to an Ollama you run some other way;
# the OLLAMA_* tuning below then has no effect.
OLLAMA_MANAGED=true
OLLAMA_BIN=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Where Ollama keeps its models. Leave empty for Ollama's default (~/.ollama/models).
# If you previously ran the Debian/systemd install, its models live in
# /usr/share/ollama/.ollama/models and can be reused read-only.
OLLAMA_MODELS=
OLLAMA_START_TIMEOUT_MS=30000
# Preload the model into VRAM at startup so the first request is fast.
OLLAMA_PRELOAD=true

# ---- Model + inference tuning (passed to the managed Ollama) -----------
MODEL=qwen3.5:4b
NUM_CTX=8192
# Layers to place on the GPU. qwen3.5:4b has 34; Ollama's auto-fit reserves
# ~1 GB for the model's vision encoder and only offloads 23, which is ~3x
# slower. -1 = let Ollama decide.
NUM_GPU=34
KV_CACHE_TYPE=q8_0
FLASH_ATTENTION=true
KEEP_ALIVE=30m
# Must equal the number of requests Ollama runs concurrently (OLLAMA_NUM_PARALLEL).
MAX_PARALLEL=2

# ---- Thinking / router --------------------------------------------------
# thinking | fast | adaptive
DEFAULT_MODE=adaptive
THINK_BUDGET_TOKENS=1024
# Used when the caller sends no max_tokens.
DEFAULT_MAX_TOKENS=2048
ADAPTIVE_SHORT_TOKENS=60
ADAPTIVE_TOOLS_THINK=true
CLASSIFIER_TIMEOUT_MS=3000

# ---- Tool calling -------------------------------------------------------
# native: pass tools to Ollama's chat template and parse <tool_call> text if
#         Ollama does not return structured tool_calls (default).
# prompt: never pass tools to Ollama; inject the Hermes-style tool block into
#         the system prompt and always parse <tool_call> text.
TOOL_INJECTION=native
# Strip validation-only keywords (additionalProperties, title, $schema, examples,
# strict...) from tool schemas before they are rendered into the prompt. The
# full schema is still used to validate the model's arguments.
TOOL_SCHEMA_SLIM=true

# ---- Limits -------------------------------------------------------------
QUEUE_TIMEOUT_MS=120000
UPSTREAM_TIMEOUT_MS=600000
# Estimated prompt tokens (chars/4) above this are rejected with 400.
MAX_PROMPT_TOKENS=7000
