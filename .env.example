# Every variable here has a default (see src/config.ts) — nothing below is
# required. .env only needs to hold what you want to override. Full
# reference: README.md -> Configuration.

PORT=8000

# Uncomment to require "Authorization: Bearer <key>" on /v1/*.
# API_KEY=

# Layers of qwen3.5:4b (34 total) to put on the GPU. -1 = Ollama auto-fit,
# which under-offloads on small GPUs; see README -> "Why the GPU settings matter".
NUM_GPU=34

# Reuse models from an existing Ollama install instead of re-pulling.
# OLLAMA_MODELS=/usr/share/ollama/.ollama/models
