{
  "name": "qwen-proxy",
  "version": "0.1.0",
  "description": "Minimal OpenAI-compatible proxy over Ollama for Qwen3.5: adaptive thinking, robust tool calls, validated structured output",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun src/index.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.1.38",
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "ajv": "^8.20.0",
    "express": "^4.22.2",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
